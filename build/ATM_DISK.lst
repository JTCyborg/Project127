  1+++66AE              ; =========================================================================
  2+++66AE              ; Project127 ATM physical-page manager
  3+++66AE              ; ATM RAM: 64 x 16 KiB pages, mapped through four 16 KiB CPU windows.
  4+++66AE              ;
  5+++66AE              ; Public request ABI:
  6+++66AE              ;   atm_mem_request_length[4]  UINT32 byte length
  7+++66AE              ;   atm_mem_request_offset[4]  UINT32 physical byte offset (FREE)
  8+++66AE              ;   atm_mem_result_offset[4]   UINT32 physical byte offset (ALLOC result)
  9+++66AE              ;
 10+++66AE              ; ALLOC returns a page-aligned contiguous physical extent. The caller sees
 11+++66AE              ; a 32-bit byte offset; page numbers and the 16 KiB mapping window are private.
 12+++66AE              ; READ/WRITE/STREAM operations will use the same mapper and split internally.
 13+++66AE              ;
 14+++66AE              ; Reserved pages are based on the Project112 ATM2+ memory map and the P127
 15+++66AE              ; boot runtime: page 0 system/BASIC map, page 2 host stack, page 5 host image,
 16+++66AE              ; pages 1/5 ATM video pair, and pages 3/7 alternate ZX video pages.
 17+++66AE              ; =========================================================================
