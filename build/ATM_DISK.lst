# file opened: atm_memory_backend.asm
  1++ 64DA              ; Project127 ATM Turbo 2+ memory backend.
  2++ 64DA              ; Physical capacity: 1 MiB (64 x 16 KiB pages).
  3++ 64DA              ; ATM page selection is private to atm_memory_manager.asm.
  4++ 64DA              ; Reserved pages: 0,1,2,3,5,7; allocator owns the remaining 58 pages.
  5++ 64DA              ;
  6++ 64DA              ; atm_mem_query_caps: HL -> 18-byte capability record
  7++ 64DA              ; atm_mem_validate_range: carry clear iff offset+length is in 1 MiB
