  1++ 60EE              ; Project127 ATM Turbo 2+ memory backend — capability and range core.
  2++ 60EE              ; Physical capacity is the agreed 1 MiB ATM RAM configuration.
  3++ 60EE              ; Active video backing and system reservations are NOT allocatable.
  4++ 60EE              ; Project112 proves video mappings (physical page 5/page 1), but does not
  5++ 60EE              ; define a complete general-purpose physical-page selector for all ATM RAM.
  6++ 60EE              ;
  7++ 60EE              ; atm_mem_query_caps: HL -> 18-byte capability record
  8++ 60EE              ; atm_mem_validate_range: carry clear iff offset+length is in 1 MiB
  9++ 60EE              ; atm_mem_range_selftest: carry clear iff all arithmetic boundary tests pass
 10++ 60EE              ;
 11++ 60EE              ; READ/WRITE/ALLOC/FREE are not advertised until page selection and the
 12++ 60EE              ; reservation map are implemented and tested on target.
 13++ 60EE
