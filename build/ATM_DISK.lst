  2+++669C              ; Project127 ATM physical-page manager
  3+++669C              ; ATM RAM: 64 x 16 KiB pages, mapped through four 16 KiB CPU windows.
  4+++669C              ;
  5+++669C              ; Public request ABI:
  6+++669C              ;   atm_mem_request_length[4]  UINT32 byte length
  7+++669C              ;   atm_mem_request_offset[4]  UINT32 physical byte offset (FREE)
  8+++669C              ;   atm_mem_result_offset[4]   UINT32 physical byte offset (ALLOC result)
  9+++669C              ;
 10+++669C              ; ALLOC returns a page-aligned contiguous physical extent. The caller sees
 11+++669C              ; a 32-bit byte offset; page numbers and the 16 KiB mapping window are private.
 12+++669C              ; READ/WRITE/STREAM operations will use the same mapper and split internally.
 13+++669C              ;
 14+++669C              ; Reserved pages are based on the Project112 ATM2+ memory map and the P127
 15+++669C              ; boot runtime: page 0 system/BASIC map, page 2 host stack, page 5 host image,
 16+++669C              ; pages 1/5 ATM video pair, and pages 3/7 alternate ZX video pages.
