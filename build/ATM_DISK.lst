  1+++7B9F              ; Project127 ATM logical scatter-handle operations.
  2+++7B9F              ; All offsets and lengths are UINT32 byte quantities relative to an opaque
  3+++7B9F              ; handle. Physical extent vectors are resolved privately for each byte.
  4+++7B9F              ;
  5+++7B9F              ; Descriptors:
  6+++7B9F              ;   atm_mem_handle_source       db handle id
  7+++7B9F              ;   atm_mem_handle_destination  db handle id
  8+++7B9F              ;   atm_mem_handle_source_offset      defs 4
  9+++7B9F              ;   atm_mem_handle_destination_offset defs 4
 10+++7B9F              ;   atm_mem_handle_op_length          defs 4
 11+++7B9F              ;   atm_mem_handle_fill_value   db value
 12+++7B9F              ;
 13+++7B9F              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7B9F              ; READ convention: source=object, destination=transfer handle.
 15+++7B9F              ; WRITE convention: source=transfer handle, destination=object.
 16+++7B9F              ; FILL and COPY are handle-relative. Carry clear means complete operation.
 17+++7B9F              ;
 18+++7B9F              ; Bytewise implementation intentionally favors correctness first. It maps
 19+++7B9F              ; only window 3 and restores page 1 on successful completion.
 20+++7B9F
 21+++7B9F              atm_mem_handle_read:
 21+++7B9F
 22+++7B9F C3 A5 7B             jp      atm_mem_handle_copy
 23+++7BA2
 24+++7BA2              atm_mem_handle_write:
 24+++7BA2
 25+++7BA2 C3 A5 7B             jp      atm_mem_handle_copy
 26+++7BA5
