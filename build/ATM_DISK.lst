  1+++66A2              ; =========================================================================
  2+++66A2              ; Project127 ATM physical-page manager
  3+++66A2              ; ATM RAM: 64 x 16 KiB pages, mapped through four 16 KiB CPU windows.
  4+++66A2              ;
  5+++66A2              ; Public request ABI:
  6+++66A2              ;   atm_mem_request_length[4]  UINT32 byte length
  7+++66A2              ;   atm_mem_request_offset[4]  UINT32 physical byte offset (FREE)
  8+++66A2              ;   atm_mem_result_offset[4]   UINT32 physical byte offset (ALLOC result)
  9+++66A2              ;
 10+++66A2              ; ALLOC returns a page-aligned contiguous physical extent. The caller sees
 11+++66A2              ; a 32-bit byte offset; page numbers and the 16 KiB mapping window are private.
 12+++66A2              ; READ/WRITE/STREAM operations will use the same mapper and split internally.
 13+++66A2              ;
 14+++66A2              ; Reserved pages are based on the Project112 ATM2+ memory map and the P127
 15+++66A2              ; boot runtime: page 0 system/BASIC map, page 2 host stack, page 5 host image,
 16+++66A2              ; pages 1/5 ATM video pair, and pages 3/7 alternate ZX video pages.
 17+++66A2              ; =========================================================================
