  2+  9000              ; PROJECT127 ATM native video service v0.1.0
  3+  9000              ; Confirmed ATM Turbo 2+ RG6 80x25 text framebuffer.
  4+  9000              ; Host code occupies page 5, so video uses the established alternate
  5+  9000              ; framebuffer pages 7 (characters) and 3 (attributes).
  6+  9000              ;
  7+  9000              ; API:
  8+  9000              ;   P127_ATM_Video_Query: A=mode register, B=columns, C=rows, HL=frame bytes
  9+  9000              ;   P127_ATM_Video_WriteCell: D=row, E=column, A=character; carry=invalid
 10+  9000              ;   P127_ATM_Video_Clear: clears the 80x25 character/attribute planes
 11+  9000              ;   P127_ATM_Video_SelfTest: geometry-only test; carry clear=pass
 12+  9000              ; =========================================================================
 13+  9000              P127_ATM_VIDEO_VERSION       EQU #0100
 14+  9000              P127_ATM_VIDEO_MODE_RG6      EQU #C6
 15+  9000              P127_ATM_VIDEO_COLUMNS       EQU 80
 16+  9000              P127_ATM_VIDEO_ROWS          EQU 25
 17+  9000              P127_ATM_VIDEO_FRAME_BYTES   EQU 4000
 18+  9000              P127_ATM_VIDEO_PAGE7         EQU #78
 19+  9000              P127_ATM_VIDEO_PAGE3         EQU #7C
