  2+++662E              ; Project127 ATM physical-page manager
  3+++662E              ; ATM RAM: 64 x 16 KiB pages, mapped through four 16 KiB CPU windows.
  4+++662E              ;
  5+++662E              ; Public request ABI:
  6+++662E              ;   atm_mem_request_length[4]  UINT32 byte length
  7+++662E              ;   atm_mem_request_offset[4]  UINT32 physical byte offset (FREE)
  8+++662E              ;   atm_mem_result_offset[4]   UINT32 physical byte offset (ALLOC result)
  9+++662E              ;
 10+++662E              ; ALLOC returns a page-aligned contiguous physical extent. The caller sees
 11+++662E              ; a 32-bit byte offset; page numbers and the 16 KiB mapping window are private.
 12+++662E              ; READ/WRITE/STREAM operations will use the same mapper and split internally.
 13+++662E              ;
 14+++662E              ; Reserved pages are based on the Project112 ATM2+ memory map and the P127
 15+++662E              ; boot runtime: page 0 system/BASIC map, page 2 host stack, page 5 host image,
 16+++662E              ; pages 1/5 ATM video pair, and pages 3/7 alternate ZX video pages.
 17+++662E              ; =========================================================================
