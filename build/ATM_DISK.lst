 27+++7BB4
 28+++7BB4 3A F7 7D             ld      a,(atm_mem_handle_source)
 29+++7BB7 21 F9 7D             ld      hl,atm_mem_handle_source_offset
 30+++7BBA CD C1 7C             call    atm_mem_handle_validate_range
 31+++7BBD D8                   ret     c
 32+++7BBE 3A F8 7D             ld      a,(atm_mem_handle_destination)
 33+++7BC1 21 FD 7D             ld      hl,atm_mem_handle_destination_offset
