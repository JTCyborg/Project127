 12+++7AE4              ;
 13+++7AE4              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7AE4              ; READ convention: source=object, destination=transfer handle.
 15+++7AE4              ; WRITE convention: source=transfer handle, destination=object.
 16+++7AE4              ; FILL and COPY are handle-relative. Carry clear means complete operation.
