# file opened: atm_memory_handle_ops.asm
  1+++7B9C              ; Project127 ATM logical scatter-handle operations.
  2+++7B9C              ; All offsets and lengths are UINT32 byte quantities relative to an opaque
  3+++7B9C              ; handle. Physical extent vectors are resolved privately for each byte.
  4+++7B9C              ;
  5+++7B9C              ; Descriptors:
  6+++7B9C              ;   atm_mem_handle_source       db handle id
  7+++7B9C              ;   atm_mem_handle_destination  db handle id
  8+++7B9C              ;   atm_mem_handle_source_offset      defs 4
  9+++7B9C              ;   atm_mem_handle_destination_offset defs 4
 10+++7B9C              ;   atm_mem_handle_op_length          defs 4
 11+++7B9C              ;   atm_mem_handle_fill_value   db value
 12+++7B9C              ;
 13+++7B9C              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7B9C              ; READ convention: source=object, destination=transfer handle.
 15+++7B9C              ; WRITE convention: source=transfer handle, destination=object.
 16+++7B9C              ; FILL and COPY are handle-relative. Carry clear means complete operation.
 17+++7B9C              ;
 18+++7B9C              ; Bytewise implementation intentionally favors correctness first. It maps
 19+++7B9C              ; only window 3 and restores page 1 on successful completion.
 20+++7B9C
 21+++7B9C              atm_mem_handle_read:
 21+++7B9C
 22+++7B9C C3 A2 7B             jp      atm_mem_handle_copy
 23+++7B9F
 24+++7B9F              atm_mem_handle_write:
 24+++7B9F
 25+++7B9F C3 A2 7B             jp      atm_mem_handle_copy
 26+++7BA2
