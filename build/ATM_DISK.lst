  1+++7B90              ; Project127 ATM logical scatter-handle operations.
  2+++7B90              ; All offsets and lengths are UINT32 byte quantities relative to an opaque
  3+++7B90              ; handle. Physical extent vectors are resolved privately for each byte.
  4+++7B90              ;
  5+++7B90              ; Descriptors:
  6+++7B90              ;   atm_mem_handle_source       db handle id
  7+++7B90              ;   atm_mem_handle_destination  db handle id
  8+++7B90              ;   atm_mem_handle_source_offset      defs 4
  9+++7B90              ;   atm_mem_handle_destination_offset defs 4
 10+++7B90              ;   atm_mem_handle_op_length          defs 4
 11+++7B90              ;   atm_mem_handle_fill_value   db value
 12+++7B90              ;
 13+++7B90              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7B90              ; READ convention: source=object, destination=transfer handle.
 15+++7B90              ; WRITE convention: source=transfer handle, destination=object.
 16+++7B90              ; FILL and COPY are handle-relative. Carry clear means complete operation.
 17+++7B90              ;
 18+++7B90              ; Bytewise implementation intentionally favors correctness first. It maps
 19+++7B90              ; only window 3 and restores page 1 on successful completion.
