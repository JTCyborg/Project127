  1+++7BA2              ; Project127 ATM logical scatter-handle operations.
  2+++7BA2              ; All offsets and lengths are UINT32 byte quantities relative to an opaque
  3+++7BA2              ; handle. Physical extent vectors are resolved privately for each byte.
  4+++7BA2              ;
  5+++7BA2              ; Descriptors:
  6+++7BA2              ;   atm_mem_handle_source       db handle id
  7+++7BA2              ;   atm_mem_handle_destination  db handle id
  8+++7BA2              ;   atm_mem_handle_source_offset      defs 4
  9+++7BA2              ;   atm_mem_handle_destination_offset defs 4
 10+++7BA2              ;   atm_mem_handle_op_length          defs 4
 11+++7BA2              ;   atm_mem_handle_fill_value   db value
 12+++7BA2              ;
 13+++7BA2              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7BA2              ; READ convention: source=object, destination=transfer handle.
 15+++7BA2              ; WRITE convention: source=transfer handle, destination=object.
 16+++7BA2              ; FILL and COPY are handle-relative. Carry clear means complete operation.
 17+++7BA2              ;
 18+++7BA2              ; Bytewise implementation intentionally favors correctness first. It maps
 19+++7BA2              ; only window 3 and restores page 1 on successful completion.
 20+++7BA2
