 11++ A706              ;   atm_mem_source_offset, atm_mem_destination_offset, atm_mem_op_length
 12++ A706              ; READ/WRITE use the same validated physical copy primitive.
 13++ A706              ; COPY is memmove-safe (backward when destination > source).
 14++ A706              ; FILL uses atm_mem_fill_value.
 15++ A706              ; Carry clear = complete operation; carry set = rejected request.
