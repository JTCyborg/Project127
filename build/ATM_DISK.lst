# file opened: atm_memory_handle_ops.asm
  1+++7BAE              ; Project127 ATM logical scatter-handle operations.
  2+++7BAE              ; All offsets and lengths are UINT32 byte quantities relative to an opaque
  3+++7BAE              ; handle. Physical extent vectors are resolved privately for each byte.
  4+++7BAE              ;
  5+++7BAE              ; Descriptors:
  6+++7BAE              ;   atm_mem_handle_source       db handle id
  7+++7BAE              ;   atm_mem_handle_destination  db handle id
  8+++7BAE              ;   atm_mem_handle_source_offset      defs 4
  9+++7BAE              ;   atm_mem_handle_destination_offset defs 4
 10+++7BAE              ;   atm_mem_handle_op_length          defs 4
 11+++7BAE              ;   atm_mem_handle_fill_value   db value
 12+++7BAE              ;
 13+++7BAE              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7BAE              ; READ convention: source=object, destination=transfer handle.
 15+++7BAE              ; WRITE convention: source=transfer handle, destination=object.
 16+++7BAE              ; FILL and COPY are handle-relative. Carry clear means complete operation.
 17+++7BAE              ;
 18+++7BAE              ; Bytewise implementation intentionally favors correctness first. It maps
 19+++7BAE              ; only window 3 and restores page 1 on successful completion.
 20+++7BAE
