160++ 7BAF                      INCLUDE "drivers/atm/atm_memory_handle_ops.asm"
# file opened: atm_memory_handle_ops.asm
  1+++7BAF              ; Project127 ATM logical scatter-handle operations.
  2+++7BAF              ; All offsets and lengths are UINT32 byte quantities relative to an opaque
  3+++7BAF              ; handle. Physical extent vectors are resolved privately for each byte.
  4+++7BAF              ;
  5+++7BAF              ; Descriptors:
  6+++7BAF              ;   atm_mem_handle_source       db handle id
  7+++7BAF              ;   atm_mem_handle_destination  db handle id
  8+++7BAF              ;   atm_mem_handle_source_offset      defs 4
  9+++7BAF              ;   atm_mem_handle_destination_offset defs 4
 10+++7BAF              ;   atm_mem_handle_op_length          defs 4
 11+++7BAF              ;   atm_mem_handle_fill_value   db value
 12+++7BAF              ;
 13+++7BAF              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7BAF              ; READ convention: source=object, destination=transfer handle.
 15+++7BAF              ; WRITE convention: source=transfer handle, destination=object.
 16+++7BAF              ; FILL and COPY are handle-relative. Carry clear means complete operation.
 17+++7BAF              ;
 18+++7BAF              ; Bytewise implementation intentionally favors correctness first. It maps
 19+++7BAF              ; only window 3 and restores page 1 on successful completion.
 20+++7BAF
 21+++7BAF              atm_mem_handle_read:
 21+++7BAF
 22+++7BAF C3 B5 7B             jp      atm_mem_handle_copy
 23+++7BB2
 24+++7BB2              atm_mem_handle_write:
