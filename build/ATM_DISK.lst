# file opened: atm_memory_handle_ops.asm
  1+++7BBA              ; Project127 ATM logical scatter-handle operations.
  2+++7BBA              ; All offsets and lengths are UINT32 byte quantities relative to an opaque
  3+++7BBA              ; handle. Physical extent vectors are resolved privately for each byte.
  4+++7BBA              ;
  5+++7BBA              ; Descriptors:
  6+++7BBA              ;   atm_mem_handle_source       db handle id
  7+++7BBA              ;   atm_mem_handle_destination  db handle id
  8+++7BBA              ;   atm_mem_handle_source_offset      defs 4
  9+++7BBA              ;   atm_mem_handle_destination_offset defs 4
 10+++7BBA              ;   atm_mem_handle_op_length          defs 4
 11+++7BBA              ;   atm_mem_handle_fill_value   db value
 12+++7BBA              ;
 13+++7BBA              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7BBA              ; READ convention: source=object, destination=transfer handle.
 15+++7BBA              ; WRITE convention: source=transfer handle, destination=object.
 16+++7BBA              ; FILL and COPY are handle-relative. Carry clear means complete operation.
 17+++7BBA              ;
 18+++7BBA              ; Bytewise implementation intentionally favors correctness first. It maps
 19+++7BBA              ; only window 3 and restores page 1 on successful completion.
 20+++7BBA
 21+++7BBA              atm_mem_handle_read:
 21+++7BBA
 22+++7BBA C3 C0 7B             jp      atm_mem_handle_copy
 23+++7BBD
 24+++7BBD              atm_mem_handle_write:
 24+++7BBD
 25+++7BBD C3 C0 7B             jp      atm_mem_handle_copy
 26+++7BC0
 27+++7BC0              atm_mem_handle_copy:
 27+++7BC0
 28+++7BC0 3A 03 7E             ld      a,(atm_mem_handle_source)
 29+++7BC3 21 05 7E             ld      hl,atm_mem_handle_source_offset
