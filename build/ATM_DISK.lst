# file opened: atm_fat16.asm
  1+  B000              ; =========================================================================
  2+  B000              ; PROJECT127 — read-only FAT16 mount core v0.1.0
  3+  B000              ; ATM Z80 / Nemo IDE backend. No disk writes.
  4+  B000              ;
  5+  B000              ; API:
  6+  B000              ;   P127_FAT16_Mount
  7+  B000              ;       Carry clear: FAT16 partition mounted.
