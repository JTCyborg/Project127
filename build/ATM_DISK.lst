  1+++64EC              ; =========================================================================
  2+++64EC              ; Project127 ATM physical-page manager
  3+++64EC              ; ATM RAM: 64 x 16 KiB pages, mapped through four 16 KiB CPU windows.
  4+++64EC              ;
  5+++64EC              ; Public request ABI:
  6+++64EC              ;   atm_mem_request_length[4]  UINT32 byte length
  7+++64EC              ;   atm_mem_request_offset[4]  UINT32 physical byte offset (FREE)
  8+++64EC              ;   atm_mem_result_offset[4]   UINT32 physical byte offset (ALLOC result)
  9+++64EC              ;
 10+++64EC              ; ALLOC returns a page-aligned contiguous physical extent. The caller sees
 11+++64EC              ; a 32-bit byte offset; page numbers and the 16 KiB mapping window are private.
 12+++64EC              ; READ/WRITE/STREAM operations will use the same mapper and split internally.
 13+++64EC              ;
 14+++64EC              ; Reserved pages are based on the Project112 ATM2+ memory map and the P127
 15+++64EC              ; boot runtime: page 0 system/BASIC map, page 2 host stack, page 5 host image,
 16+++64EC              ; pages 1/5 ATM video pair, and pages 3/7 alternate ZX video pages.
 17+++64EC              ; =========================================================================
