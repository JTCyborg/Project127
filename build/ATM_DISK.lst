# file opened: atm_memory_backend.asm
  1++ 6478              ; Project127 ATM Turbo 2+ memory backend.
  2++ 6478              ; Physical capacity: 1 MiB (64 x 16 KiB pages).
  3++ 6478              ; ATM page selection is private to atm_memory_manager.asm.
  4++ 6478              ; Reserved pages: 0,1,2,3,5,7; allocator owns the remaining 58 pages.
  5++ 6478              ;
  6++ 6478              ; atm_mem_query_caps: HL -> 18-byte capability record
  7++ 6478              ; atm_mem_validate_range: carry clear iff offset+length is in 1 MiB
  8++ 6478              ; atm_mem_range_selftest: carry clear iff all arithmetic boundary tests pass
  9++ 6478              ;
 10++ 6478              ; ALLOC/FREE and UINT32 byte READ/WRITE/FILL/COPY are implemented.
 11++ 6478              ; Operations use a bytewise single-aperture engine; multi-extent handles remain future work.
