# file opened: atm_memory_backend.asm
 1++  60D3              ; Project127 ATM Turbo 2+ memory backend — capability and range core.
 2++  60D3              ; Physical capacity is the agreed 1 MiB ATM RAM configuration.
 3++  60D3              ; Active video backing and system reservations are NOT allocatable.
 4++  60D3              ; Project112 proves video mappings (physical page 5/page 1), but does not
 5++  60D3              ; define a complete general-purpose physical-page selector for all ATM RAM.
 6++  60D3              ;
 7++  60D3              ; atm_mem_query_caps: HL -> 18-byte capability record
 8++  60D3              ; atm_mem_validate_range: carry clear iff offset+length is in 1 MiB
 9++  60D3              ; atm_mem_range_selftest: carry clear iff all arithmetic boundary tests pass
10++  60D3              ;
11++  60D3              ; READ/WRITE/ALLOC/FREE are not advertised until page selection and the
12++  60D3              ; reservation map are implemented and tested on target.
13++  60D3
14++  60D3                      INCLUDE "drivers/shared/p127_memory_core.inc"
