# file opened: atm_memory_handle_ops.asm
  1+++7BBD              ; Project127 ATM logical scatter-handle operations.
  2+++7BBD              ; All offsets and lengths are UINT32 byte quantities relative to an opaque
  3+++7BBD              ; handle. Physical extent vectors are resolved privately for each byte.
  4+++7BBD              ;
  5+++7BBD              ; Descriptors:
  6+++7BBD              ;   atm_mem_handle_source       db handle id
  7+++7BBD              ;   atm_mem_handle_destination  db handle id
  8+++7BBD              ;   atm_mem_handle_source_offset      defs 4
  9+++7BBD              ;   atm_mem_handle_destination_offset defs 4
 10+++7BBD              ;   atm_mem_handle_op_length          defs 4
 11+++7BBD              ;   atm_mem_handle_fill_value   db value
 12+++7BBD              ;
 13+++7BBD              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7BBD              ; READ convention: source=object, destination=transfer handle.
 15+++7BBD              ; WRITE convention: source=transfer handle, destination=object.
 16+++7BBD              ; FILL and COPY are handle-relative. Carry clear means complete operation.
 17+++7BBD              ;
 18+++7BBD              ; Bytewise implementation intentionally favors correctness first. It maps
 19+++7BBD              ; only window 3 and restores page 1 on successful completion.
 20+++7BBD
 21+++7BBD              atm_mem_handle_read:
 21+++7BBD
 22+++7BBD C3 C3 7B             jp      atm_mem_handle_copy
 23+++7BC0
 24+++7BC0              atm_mem_handle_write:
 24+++7BC0
 25+++7BC0 C3 C3 7B             jp      atm_mem_handle_copy
 26+++7BC3
 27+++7BC3              atm_mem_handle_copy:
 27+++7BC3
 28+++7BC3 3A 06 7E             ld      a,(atm_mem_handle_source)
