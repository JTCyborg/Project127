  1++ 6189              ; Project127 ATM Turbo 2+ memory backend — capability and range core.
  2++ 6189              ; Physical capacity is the agreed 1 MiB ATM RAM configuration.
  3++ 6189              ; Active video backing and system reservations are NOT allocatable.
  4++ 6189              ; Project112 proves video mappings (physical page 5/page 1), but does not
  5++ 6189              ; define a complete general-purpose physical-page selector for all ATM RAM.
  6++ 6189              ;
  7++ 6189              ; atm_mem_query_caps: HL -> 18-byte capability record
  8++ 6189              ; atm_mem_validate_range: carry clear iff offset+length is in 1 MiB
  9++ 6189              ; atm_mem_range_selftest: carry clear iff all arithmetic boundary tests pass
 10++ 6189              ;
 11++ 6189              ; READ/WRITE/ALLOC/FREE are not advertised until page selection and the
 12++ 6189              ; reservation map are implemented and tested on target.
