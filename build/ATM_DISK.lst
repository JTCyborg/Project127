  1++ 642E              ; Project127 ATM Turbo 2+ memory backend.
  2++ 642E              ; Physical capacity: 1 MiB (64 x 16 KiB pages).
  3++ 642E              ; ATM page selection is private to atm_memory_manager.asm.
  4++ 642E              ; Reserved pages: 0,1,2,3,5,7; allocator owns the remaining 58 pages.
  5++ 642E              ;
  6++ 642E              ; atm_mem_query_caps: HL -> 18-byte capability record
  7++ 642E              ; atm_mem_validate_range: carry clear iff offset+length is in 1 MiB
  8++ 642E              ; atm_mem_range_selftest: carry clear iff all arithmetic boundary tests pass
  9++ 642E              ;
 10++ 642E              ; ALLOC/FREE and UINT32 byte READ/WRITE/FILL/COPY are implemented.
 11++ 642E              ; Operations use a bytewise single-aperture engine; multi-extent handles remain future work.
