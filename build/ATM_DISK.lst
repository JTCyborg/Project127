  1++ 616B              ; Project127 ATM Turbo 2+ memory backend — capability and range core.
  2++ 616B              ; Physical capacity is the agreed 1 MiB ATM RAM configuration.
  3++ 616B              ; Active video backing and system reservations are NOT allocatable.
  4++ 616B              ; Project112 proves video mappings (physical page 5/page 1), but does not
  5++ 616B              ; define a complete general-purpose physical-page selector for all ATM RAM.
  6++ 616B              ;
  7++ 616B              ; atm_mem_query_caps: HL -> 18-byte capability record
  8++ 616B              ; atm_mem_validate_range: carry clear iff offset+length is in 1 MiB
  9++ 616B              ; atm_mem_range_selftest: carry clear iff all arithmetic boundary tests pass
 10++ 616B              ;
 11++ 616B              ; READ/WRITE/ALLOC/FREE are not advertised until page selection and the
 12++ 616B              ; reservation map are implemented and tested on target.
 13++ 616B
