  4++ C706              ; Safe single-aperture engine:
  5++ C706              ;   - only CPU window 3 ($C000-$FFFF) is remapped;
  6++ C706              ;   - host code remains in window 1, stack in window 2;
  7++ C706              ;   - the byte scratch and descriptors live with the host image;
  8++ C706              ;   - no caller-visible 16 KiB limit.
  9++ C706              ;
 10++ C706              ; Public descriptors (UINT32 little-endian):
 11++ C706              ;   atm_mem_source_offset, atm_mem_destination_offset, atm_mem_op_length
 12++ C706              ; READ/WRITE use the same validated physical copy primitive.
 13++ C706              ; COPY is memmove-safe (backward when destination > source).
 14++ C706              ; FILL uses atm_mem_fill_value.
 15++ C706              ; Carry clear = complete operation; carry set = rejected request.
 16++ C706              ; =========================================================================
