# file opened: atm_memory_handle_ops.asm
  1+++7BCB              ; Project127 ATM logical scatter-handle operations.
  2+++7BCB              ; All offsets and lengths are UINT32 byte quantities relative to an opaque
  3+++7BCB              ; handle. Physical extent vectors are resolved privately for each byte.
  4+++7BCB              ;
  5+++7BCB              ; Descriptors:
  6+++7BCB              ;   atm_mem_handle_source       db handle id
  7+++7BCB              ;   atm_mem_handle_destination  db handle id
  8+++7BCB              ;   atm_mem_handle_source_offset      defs 4
  9+++7BCB              ;   atm_mem_handle_destination_offset defs 4
 10+++7BCB              ;   atm_mem_handle_op_length          defs 4
 11+++7BCB              ;   atm_mem_handle_fill_value   db value
 12+++7BCB              ;
 13+++7BCB              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7BCB              ; READ convention: source=object, destination=transfer handle.
 15+++7BCB              ; WRITE convention: source=transfer handle, destination=object.
 16+++7BCB              ; FILL and COPY are handle-relative. Carry clear means complete operation.
 17+++7BCB              ;
 18+++7BCB              ; Bytewise implementation intentionally favors correctness first. It maps
