  1+++6B34              ; =========================================================================
  2+++6B34              ; Project127 ATM byte-range operations.
  3+++6B34              ;
  4+++6B34              ; Safe single-aperture engine:
  5+++6B34              ;   - only CPU window 3 ($C000-$FFFF) is remapped;
  6+++6B34              ;   - host code remains in window 1, stack in window 2;
  7+++6B34              ;   - the byte scratch and descriptors live with the host image;
  8+++6B34              ;   - no caller-visible 16 KiB limit.
  9+++6B34              ;
 10+++6B34              ; Public descriptors (UINT32 little-endian):
 11+++6B34              ;   atm_mem_source_offset, atm_mem_destination_offset, atm_mem_op_length
 12+++6B34              ; READ/WRITE use the same validated physical copy primitive.
 13+++6B34              ; COPY is memmove-safe (backward when destination > source).
 14+++6B34              ; FILL uses atm_mem_fill_value.
 15+++6B34              ; Carry clear = complete operation; carry set = rejected request.
 16+++6B34              ; =========================================================================
 17+++6B34
 18+++6B34              atm_mem_read:
