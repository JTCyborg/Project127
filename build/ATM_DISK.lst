# file opened: atm_memory_handle_ops.asm
  1+++7BC0              ; Project127 ATM logical scatter-handle operations.
  2+++7BC0              ; All offsets and lengths are UINT32 byte quantities relative to an opaque
  3+++7BC0              ; handle. Physical extent vectors are resolved privately for each byte.
  4+++7BC0              ;
  5+++7BC0              ; Descriptors:
  6+++7BC0              ;   atm_mem_handle_source       db handle id
  7+++7BC0              ;   atm_mem_handle_destination  db handle id
  8+++7BC0              ;   atm_mem_handle_source_offset      defs 4
  9+++7BC0              ;   atm_mem_handle_destination_offset defs 4
 10+++7BC0              ;   atm_mem_handle_op_length          defs 4
 11+++7BC0              ;   atm_mem_handle_fill_value   db value
 12+++7BC0              ;
 13+++7BC0              ; READ and WRITE use the same validated handle-to-handle copy primitive:
 14+++7BC0              ; READ convention: source=object, destination=transfer handle.
 15+++7BC0              ; WRITE convention: source=transfer handle, destination=object.
 16+++7BC0              ; FILL and COPY are handle-relative. Carry clear means complete operation.
 17+++7BC0              ;
 18+++7BC0              ; Bytewise implementation intentionally favors correctness first. It maps
 19+++7BC0              ; only window 3 and restores page 1 on successful completion.
 20+++7BC0
 21+++7BC0              atm_mem_handle_read:
 21+++7BC0
 22+++7BC0 C3 C6 7B             jp      atm_mem_handle_copy
 23+++7BC3
 24+++7BC3              atm_mem_handle_write:
