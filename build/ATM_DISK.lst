  1++ C1B6              ; =========================================================================
  2++ C1B6              ; Project127 ATM physical-page manager
  3++ C1B6              ; ATM RAM: 64 x 16 KiB pages, mapped through four 16 KiB CPU windows.
  4++ C1B6              ;
  5++ C1B6              ; Public request ABI:
  6++ C1B6              ;   atm_mem_request_length[4]  UINT32 byte length
  7++ C1B6              ;   atm_mem_request_offset[4]  UINT32 physical byte offset (FREE)
  8++ C1B6              ;   atm_mem_result_offset[4]   UINT32 physical byte offset (ALLOC result)
  9++ C1B6              ;
 10++ C1B6              ; ALLOC returns a page-aligned contiguous physical extent. The caller sees
 11++ C1B6              ; a 32-bit byte offset; page numbers and the 16 KiB mapping window are private.
 12++ C1B6              ; READ/WRITE/STREAM operations will use the same mapper and split internally.
 13++ C1B6              ;
 14++ C1B6              ; Reserved pages are based on the Project112 ATM2+ memory map and the P127
 15++ C1B6              ; boot runtime: page 0 system/BASIC map, page 2 host stack, page 5 host image,
 16++ C1B6              ; pages 1/5 ATM video pair, and pages 3/7 alternate ZX video pages.
 17++ C1B6              ; =========================================================================
