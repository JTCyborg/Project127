  1+++66BD              ; =========================================================================
  2+++66BD              ; Project127 ATM physical-page manager
  3+++66BD              ; ATM RAM: 64 x 16 KiB pages, mapped through four 16 KiB CPU windows.
  4+++66BD              ;
  5+++66BD              ; Public request ABI:
  6+++66BD              ;   atm_mem_request_length[4]  UINT32 byte length
  7+++66BD              ;   atm_mem_request_offset[4]  UINT32 physical byte offset (FREE)
  8+++66BD              ;   atm_mem_result_offset[4]   UINT32 physical byte offset (ALLOC result)
  9+++66BD              ;
 10+++66BD              ; ALLOC returns a page-aligned contiguous physical extent. The caller sees
 11+++66BD              ; a 32-bit byte offset; page numbers and the 16 KiB mapping window are private.
 12+++66BD              ; READ/WRITE/STREAM operations will use the same mapper and split internally.
 13+++66BD              ;
 14+++66BD              ; Reserved pages are based on the Project112 ATM2+ memory map and the P127
 15+++66BD              ; boot runtime: page 0 system/BASIC map, page 2 host stack, page 5 host image,
 16+++66BD              ; pages 1/5 ATM video pair, and pages 3/7 alternate ZX video pages.
 17+++66BD              ; =========================================================================
