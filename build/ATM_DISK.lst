  1+++66AF              ; =========================================================================
  2+++66AF              ; Project127 ATM physical-page manager
  3+++66AF              ; ATM RAM: 64 x 16 KiB pages, mapped through four 16 KiB CPU windows.
  4+++66AF              ;
  5+++66AF              ; Public request ABI:
  6+++66AF              ;   atm_mem_request_length[4]  UINT32 byte length
  7+++66AF              ;   atm_mem_request_offset[4]  UINT32 physical byte offset (FREE)
  8+++66AF              ;   atm_mem_result_offset[4]   UINT32 physical byte offset (ALLOC result)
  9+++66AF              ;
 10+++66AF              ; ALLOC returns a page-aligned contiguous physical extent. The caller sees
 11+++66AF              ; a 32-bit byte offset; page numbers and the 16 KiB mapping window are private.
 12+++66AF              ; READ/WRITE/STREAM operations will use the same mapper and split internally.
 13+++66AF              ;
 14+++66AF              ; Reserved pages are based on the Project112 ATM2+ memory map and the P127
 15+++66AF              ; boot runtime: page 0 system/BASIC map, page 2 host stack, page 5 host image,
 16+++66AF              ; pages 1/5 ATM video pair, and pages 3/7 alternate ZX video pages.
