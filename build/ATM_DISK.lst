# file opened: atm_storage_nemo.asm
  1+  C400              ; =========================================================================
  2+  C400              ; PROJECT127 — ATM physical storage backend v0.1.0
  3+  C400              ; Nemo IDE ATA PIO backend. ATM Z80 only.
  4+  C400              ; Safe startup probe: IDENTIFY DEVICE (no writes during detection).
  5+  C400              ;
  6+  C400              ; Public low-level API:
  7+  C400              ;   P127_Storage_Startup       -> carry clear if supported LBA28 device found
  8+  C400              ;   P127_Storage_ReadSector   -> IX=512-byte destination, LBA in descriptor
  9+  C400              ;   P127_Storage_WriteSector  -> IX=512-byte source, LBA in descriptor
 10+  C400              ;   P127_Storage_Flush        -> flush cache
 11+  C400              ;   P127_Storage_SetLBA       -> HL=low16, DE=high16 (upper nibble must be 0)
 12+  C400              ;
 13+  C400              ; Status: A=0 success, A=error code and carry set on failure.
 14+  C400              ; Error codes: 1 no device/not ready, 2 ATA ERR, 3 timeout,
 15+  C400              ;              4 LBA28 unsupported, 5 invalid LBA.
 16+  C400              ; =========================================================================
 17+  C400
 18+  C400              ; ATM Nemo IDE uses the 16-bit port decode from Project126/kernel/main.asm.
 19+  C400              ; Do not use the NeoGS-side low-byte aliases (#10..#F0) on the ATM host.
 20+  C400              P127_NEMO_DATA_LO       EQU #FE0F
 21+  C400              P127_NEMO_DATA_HI       EQU #FF0F
 22+  C400              P127_NEMO_ERROR         EQU #FE2F
 23+  C400              P127_NEMO_SECTOR_COUNT  EQU #FE4F
 24+  C400              P127_NEMO_LBA_LOW       EQU #FE6F
 25+  C400              P127_NEMO_LBA_MID       EQU #FE8F
 26+  C400              P127_NEMO_LBA_HIGH      EQU #FEAF
 27+  C400              P127_NEMO_DRIVE_HEAD    EQU #FECF
 28+  C400              P127_NEMO_STATUS_CMD    EQU #FEEF
 29+  C400              P127_NEMO_WAIT_LIMIT    EQU #FFFF
 30+  C400              P127_STORAGE_VERSION    EQU #0100
 31+  C400
 32+  C400              P127_Storage_Startup:
 33+  C400 AF                   xor     a
 34+  C401 32 CF C5             ld      (p127_storage_available),a
 35+  C404 21 DA C7             ld      hl,p127_storage_log_select
 36+  C407 CD CF 61             call    p127_host_debug_string
 37+  C40A 21 FB C7             ld      hl,p127_storage_log_wait_ready
 38+  C40D CD CF 61             call    p127_host_debug_string
 39+  C410                      ; Match the proven Project127/0 sequence: select Master and poll
 40+  C410                      ; immediately. Do not run console/debug code between these operations.
 41+  C410 3E E0                ld      a,#E0                 ; master, LBA mode
 42+  C412 01 CF FE             ld      bc,P127_NEMO_DRIVE_HEAD
 43+  C415 ED 79                out     (c),a
 44+  C417 CD 30 C5             call    p127_storage_wait_ready
