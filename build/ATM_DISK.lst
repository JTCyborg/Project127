  1+  A400              ; =========================================================================
  2+  A400              ; PROJECT127 — ATM physical storage backend v0.1.0
  3+  A400              ; Nemo IDE ATA PIO backend. ATM Z80 only.
  4+  A400              ; Safe startup probe: IDENTIFY DEVICE (no writes during detection).
  5+  A400              ;
  6+  A400              ; Public low-level API:
  7+  A400              ;   P127_Storage_Startup       -> carry clear if supported LBA28 device found
  8+  A400              ;   P127_Storage_ReadSector   -> IX=512-byte destination, LBA in descriptor
  9+  A400              ;   P127_Storage_WriteSector  -> IX=512-byte source, LBA in descriptor
 10+  A400              ;   P127_Storage_Flush        -> flush cache
 11+  A400              ;   P127_Storage_SetLBA       -> HL=low16, DE=high16 (upper nibble must be 0)
 12+  A400              ;
 13+  A400              ; Status: A=0 success, A=error code and carry set on failure.
 14+  A400              ; Error codes: 1 no device/not ready, 2 ATA ERR, 3 timeout,
 15+  A400              ;              4 LBA28 unsupported, 5 invalid LBA.
 16+  A400              ; =========================================================================
 17+  A400
 18+  A400              P127_NEMO_DATA_LO       EQU #10
 19+  A400              P127_NEMO_DATA_HI       EQU #11
 20+  A400              P127_NEMO_SECTOR_COUNT  EQU #50
 21+  A400              P127_NEMO_LBA_LOW       EQU #70
 22+  A400              P127_NEMO_LBA_MID       EQU #90
 23+  A400              P127_NEMO_LBA_HIGH      EQU #B0
 24+  A400              P127_NEMO_DRIVE_HEAD    EQU #D0
 25+  A400              P127_NEMO_STATUS_CMD    EQU #F0
 26+  A400              P127_NEMO_WAIT_LIMIT    EQU #FFFF
 27+  A400              P127_STORAGE_VERSION    EQU #0100
