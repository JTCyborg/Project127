  1+++6690              ; =========================================================================
  2+++6690              ; Project127 ATM physical-page manager
  3+++6690              ; ATM RAM: 64 x 16 KiB pages, mapped through four 16 KiB CPU windows.
  4+++6690              ;
  5+++6690              ; Public request ABI:
  6+++6690              ;   atm_mem_request_length[4]  UINT32 byte length
  7+++6690              ;   atm_mem_request_offset[4]  UINT32 physical byte offset (FREE)
  8+++6690              ;   atm_mem_result_offset[4]   UINT32 physical byte offset (ALLOC result)
  9+++6690              ;
 10+++6690              ; ALLOC returns a page-aligned contiguous physical extent. The caller sees
 11+++6690              ; a 32-bit byte offset; page numbers and the 16 KiB mapping window are private.
 12+++6690              ; READ/WRITE/STREAM operations will use the same mapper and split internally.
 13+++6690              ;
 14+++6690              ; Reserved pages are based on the Project112 ATM2+ memory map and the P127
 15+++6690              ; boot runtime: page 0 system/BASIC map, page 2 host stack, page 5 host image,
 16+++6690              ; pages 1/5 ATM video pair, and pages 3/7 alternate ZX video pages.
 17+++6690              ; =========================================================================
